effect_line_text = "100% MAG Water damage | Projectile | 2 ATB"
short_effect_text = "100% Water"
description_text = "A pressurized water bubble shot at one target. Direct damage, no extra effect."
mechanics_text = "Magical Water projectile. Direct damage on contact; scales with MAG and is reduced by the target's WIS."
visual_text = "A hollow, iridescent thin-film bubble that inflates in front of the caster, skips once off the ground and bursts into a hydraulic spray of water and mini-bubbles on impact."
motion_text = "Stationary launch. The bubble flies in two arcs with a single ground bounce toward the target."
windup_text = "0.70s wind-up. The bubble inflates under pressure in front of the caster."
tactical_text = "Fast, cheap single-target Water damage. Dodgeable in the last 0.25s of flight."
visual_motion_text = "Stationary launch of an iridescent pressure bubble that bounces once."
