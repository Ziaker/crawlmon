windup_text = "1.00s wind-up. The white hand materializes at the shoulder and cocks back."
tactical_text = "Direct martial chop with a 30% chance of -1 SPD on the target. Single Target."
visual_motion_text = "White hologram knife-hand cutting diagonally across the target."
