description_text = "A shuto chop for 150% ATK damage, with a 30% chance to lower the target's speed by 1 stage."
mechanics_text = "Melee strike. On contact there is a 30% chance to lower the target's speed by 1 stage (down to -5)."
visual_text = "A white holographic hand forms beside the attacker, cocks back and whips a diagonal knife-hand cut across the target, leaving a white crescent, a thin cross, sparks and chips."
