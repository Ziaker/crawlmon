extends Node2D
## Procedural dungeon look for the ASCII map in exploration.gd.
##
## Static geometry (floor, walls, decor) lives in two TileMapLayers backed by a
## TileSet built at runtime from generated atlas images, so nothing is redrawn
## per frame. Wall tiles also carry the light occlusion polygon, which replaces
## the old per-wall LightOccluder2D nodes.
##
## What is still drawn every frame is only the animated part: torches, embers,
## ambient dust and the blob shadows under the player and NPCs.

const PMD_TILESET := "res://assets/pmd/dungeons/sky/atlas/temporal_tower_atlas.png"
## Generated by tools/pmd_import/build_dungeon_atlases.py (D-345).
## The game asks for roles ("wall_n"), never for raw atlas indices.
const PMD_PROFILE := "res://assets/pmd/dungeons/sky/atlas/temporal_tower_profile.json"
const DEFAULT_ROLES := {
	"wall_tl": 0, "wall_t": 1, "wall_tr": 2,
	"wall_l": 3, "wall_c": 4, "wall_r": 5,
	"wall_bl": 6, "wall_b": 7, "wall_br": 8,
	"ground_tl": 9, "ground_t": 10, "ground_tr": 11,
	"ground_l": 12, "ground_c": 13, "ground_r": 14,
	"ground_bl": 15, "ground_b": 16, "ground_br": 17,
	"ground_alt_1": 18, "ground_alt_2": 19,
	"wall_strip_v": 20, "wall_strip_h": 21, "wall_island": 22,
	"wall_tip_n": 23, "wall_tip_s": 24, "wall_tip_w": 25,
	"wall_tip_e": 26, "wall_cross": 27,
	"wall_alt_1": 28, "wall_alt_2": 29,
}
const DEFAULT_ATLAS_COLUMNS := 30
const TILE := 48
## Bright fallback; the real tint comes from BiomeVisuals (D-358).
const AMBIENT := Color("a3b9c5")
const BiomeVisuals := preload("res://scripts/dungeon/biome_visuals.gd")

## Active atlas: Sky Temporal Tower, the categorized sheet.
## 0..8  = Walls 3x3 block (TL, T, TR, L, C, R, BL, B, BR)
## 9..17 = Ground 3x3 block (same order)
## No separate face layer: the 3x3 blocks are the categories.
const ATLAS_ROWS := 1

var _parent: Node2D
var _map: Array = []
var _decals: Dictionary = {}  ## Vector2i -> atlas index (D-356)
var _dust: CPUParticles2D
var _modulate: CanvasModulate
var _biome_name := ""
var _camera_fitted := false
var _floor_layer: TileMapLayer
var _decor_layer: TileMapLayer
var _source_id := -1
var _roles: Dictionary = DEFAULT_ROLES.duplicate()
var _role_sides: Dictionary = {}  ## side signature ("NSEW") -> atlas index
var _role_face: Dictionary = {}   ## role name -> measured side signature
var _atlas_columns := DEFAULT_ATLAS_COLUMNS
var _atlas_path := PMD_TILESET
var _profile_path := PMD_PROFILE
var _variation_seed := 0


func _ready() -> void:
	_parent = get_parent()
	texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	_modulate = CanvasModulate.new()
	_modulate.color = AMBIENT
	add_child(_modulate)


## Called by exploration.gd once the floor has been generated (this node's
## _ready runs before the parent's, so the grid is not available there).
func setup(grid: Array[String], profile_path := "", variation_seed := 0) -> void:
	_map = grid
	if not profile_path.is_empty():
		_profile_path = profile_path
	_variation_seed = variation_seed
	_clear_visuals()
	_build_tiles()
	if _modulate != null:
		_modulate.color = BiomeVisuals.ambient(_biome_name)
	queue_redraw()


## Re-entrant setup (the game calls it once; the in-game biome capture calls it
## per profile). Keeps the one CanvasModulate, frees the old layers, torches,
## embers and dust, and drops the player light so it is recreated cleanly.
func _clear_visuals() -> void:
	for child in get_children():
		if child is CanvasModulate:
			continue
		child.queue_free()
	_floor_layer = null
	_decor_layer = null
	_dust = null


func _process(_delta: float) -> void:
	if _map.is_empty():
		return
	_attach_dynamic_lights()
	queue_redraw()


# --- Tiles -------------------------------------------------------------------

## Builds the atlas, the TileSet and both layers, then fills every cell.
func _build_tiles() -> void:
	_load_profile()
	var tileset := TileSet.new()
	tileset.tile_size = Vector2i(TILE, TILE)
	tileset.add_occlusion_layer()

	var src := TileSetAtlasSource.new()
	var texture := _load_texture(_atlas_path)
	if texture == null:
		texture = _load_texture(PMD_TILESET)
	src.texture = texture
	src.texture_region_size = Vector2i(TILE, TILE)
	for row in ATLAS_ROWS:
		for col in _atlas_columns:
			src.create_tile(Vector2i(col, row))
	_source_id = tileset.add_source(src)

	# Face-aware occluders (D-355): each wall tile blocks light only on its
	# wall-mass side, leaving the lit face free. The old full-tile occluder on
	# every wall darkened the room; this keeps the floor and the faces readable.
	for role_name in _roles.keys():
		var role_key := str(role_name)
		if not role_key.begins_with("wall_"):
			continue
		var index := _role(role_key)
		if index < 0:
			continue
		var polygon := _make_occluder(role_key, _wall_signature(role_key))
		if polygon == null:
			continue
		var data := src.get_tile_data(Vector2i(index, 0), 0)
		if data == null:
			continue
		data.set_occluder_polygons_count(0, 1)
		data.set_occluder_polygon(0, 0, polygon)

	_floor_layer = _make_layer("Floor", tileset)
	_decor_layer = _make_layer("Decor", tileset)
	_build_decals()
	_fill_cells()


## Reads the role map generated next to the atlas. A missing/broken profile
## falls back to the known Temporal Tower indices, so the game still opens.
func _load_profile() -> void:
	_roles = DEFAULT_ROLES.duplicate()
	if not FileAccess.file_exists(_profile_path):
		return
	var file := FileAccess.open(_profile_path, FileAccess.READ)
	if file == null:
		return
	var data: Variant = JSON.parse_string(file.get_as_text())
	if typeof(data) != TYPE_DICTIONARY:
		return
	var roles: Variant = data.get("roles")
	if typeof(roles) == TYPE_DICTIONARY:
		for key in roles.keys():
			_roles[key] = int(roles[key])
	# Measured side signatures from the importer (D-354). The game never
	# guesses a wall face from a role name; it asks for the signature it needs.
	_role_sides.clear()
	var sides_data: Variant = data.get("role_sides")
	_role_face = sides_data if typeof(sides_data) == TYPE_DICTIONARY else {}
	var contract_ok := bool(data.get("side_contract_ok", false))
	if contract_ok and typeof(sides_data) == TYPE_DICTIONARY:
		for role_name in sides_data.keys():
			var sides := str(sides_data[role_name])
			if sides.is_empty():
				continue
			var index := int(_roles.get(role_name, -1))
			if index >= 0:
				_role_sides[sides] = index
	var columns: Variant = data.get("columns")
	if columns != null:
		_atlas_columns = maxi(1, int(columns))
	var atlas_path: Variant = data.get("atlas")
	if atlas_path != null:
		_atlas_path = str(atlas_path)
	var profile_name: Variant = data.get("name")
	if profile_name != null:
		_biome_name = str(profile_name)


func _role(role_name: String) -> int:
	return int(_roles.get(role_name, DEFAULT_ROLES.get(role_name, -1)))


## Side signature used by the face-aware occluder. Prefers the measured sides
## from the profile; falls back to the role table for older profiles (D-355).
func _wall_signature(role_name: String) -> String:
	if _role_face.has(role_name):
		return str(_role_face[role_name])
	var fallback := {
		"wall_tl": "NW", "wall_t": "N", "wall_tr": "NE",
		"wall_l": "W", "wall_c": "", "wall_r": "E",
		"wall_bl": "SW", "wall_b": "S", "wall_br": "SE",
		"wall_strip_v": "WE", "wall_strip_h": "NS",
		"wall_island": "NSWE",
		"wall_tip_n": "NWE", "wall_tip_s": "SWE",
		"wall_tip_w": "NSW", "wall_tip_e": "NSE",
		"wall_cross": "",
	}
	return str(fallback.get(role_name, ""))


## Occluder covering only the wall-mass side. The lit face side stays free,
## so the room does not darken like the old full-tile attempt.
func _make_occluder(role_name: String, signature: String) -> OccluderPolygon2D:
	if role_name == "wall_cross" or signature == "NSWE" \
		or signature == "WE" or signature == "NS":
		return null
	var h := TILE * 0.5 - 2.0
	var c := 5.0
	var points: Array[Vector2] = []
	if signature.is_empty():
		points = [
			Vector2(-h + c, -h), Vector2(h - c, -h), Vector2(h, -h + c),
			Vector2(h, h - c), Vector2(h - c, h), Vector2(-h + c, h),
			Vector2(-h, h - c), Vector2(-h, -h + c)]
	elif signature.length() == 1:
		match signature:
			"S": points = [Vector2(-h, -h), Vector2(h, -h), Vector2(h, 0), Vector2(-h, 0)]
			"N": points = [Vector2(-h, 0), Vector2(h, 0), Vector2(h, h), Vector2(-h, h)]
			"E": points = [Vector2(-h, -h), Vector2(0, -h), Vector2(0, h), Vector2(-h, h)]
			"W": points = [Vector2(0, -h), Vector2(h, -h), Vector2(h, h), Vector2(0, h)]
	elif signature.length() == 2:
		match signature:
			"SE": points = [Vector2(-h, -h), Vector2(0, -h), Vector2(0, 0), Vector2(-h, 0)]
			"SW": points = [Vector2(0, -h), Vector2(h, -h), Vector2(h, 0), Vector2(0, 0)]
			"NE": points = [Vector2(-h, 0), Vector2(0, 0), Vector2(0, h), Vector2(-h, h)]
			"NW": points = [Vector2(0, 0), Vector2(h, 0), Vector2(h, h), Vector2(0, h)]
	elif signature.length() == 3:
		var closed := _missing_side(signature)
		match closed:
			"S": points = [Vector2(-h, 0), Vector2(h, 0), Vector2(h, h), Vector2(-h, h)]
			"N": points = [Vector2(-h, -h), Vector2(h, -h), Vector2(h, 0), Vector2(-h, 0)]
			"E": points = [Vector2(0, -h), Vector2(h, -h), Vector2(h, h), Vector2(0, h)]
			"W": points = [Vector2(-h, -h), Vector2(0, -h), Vector2(0, h), Vector2(-h, h)]
	if points.is_empty():
		return null
	var polygon := OccluderPolygon2D.new()
	polygon.polygon = PackedVector2Array(points)
	return polygon


func _missing_side(signature: String) -> String:
	for side in ["N", "S", "W", "E"]:
		if not signature.contains(side):
			return side
	return ""


## Reads the current PNG directly while developing, so a rebuilt atlas does
## not need a full Godot reimport. Exported builds fall back to the imported
## texture when the raw file is not in the PCK.
func _load_texture(path: String) -> Texture2D:
	if FileAccess.file_exists(path):
		var image := Image.load_from_file(ProjectSettings.globalize_path(path))
		if image != null:
			return ImageTexture.create_from_image(image)
	return load(path)


## Layers draw behind this node's own _draw, so torches and shadows stay on top.
func _make_layer(layer_name: String, tileset: TileSet) -> TileMapLayer:
	var layer := TileMapLayer.new()
	layer.name = layer_name
	layer.tile_set = tileset
	layer.show_behind_parent = true
	add_child(layer)
	return layer


func _fill_cells() -> void:
	for y in _map.size():
		for x in _map[y].length():
			var cell := Vector2i(x, y)
			if _is_wall(x, y):
				_floor_layer.set_cell(cell, _source_id, Vector2i(_wall_tile_index(x, y), 0))
			else:
				_floor_layer.set_cell(cell, _source_id, Vector2i(_ground_tile_index(x, y), 0))


func _wall_tile_index(x: int, y: int) -> int:
	# Open = floor or outside the map (D-348). The side signature is measured
	# from the source tile by the importer (D-354); this function only asks
	# which sides are open and lets the profile return the matching real tile.
	var n := not _is_solid(x, y - 1)
	var s := not _is_solid(x, y + 1)
	var w := not _is_solid(x - 1, y)
	var e := not _is_solid(x + 1, y)
	var key := ""
	if n:
		key += "N"
	if s:
		key += "S"
	if w:
		key += "W"
	if e:
		key += "E"
	if key.is_empty():
		# All four orthogonal neighbours are wall: an interior tile or a
		# 1-tile cross with floor in all four diagonals.
		if _role("wall_cross") >= 0 and _diagonal_floor(x, y):
			return _role("wall_cross")
		var alt1 := _role("wall_alt_1")
		var alt2 := _role("wall_alt_2")
		if (alt1 >= 0 or alt2 >= 0) and _deep_wall(x, y):
			var roll := absi(_hash(x, y) ^ _variation_seed) % 100
			if alt1 >= 0 and roll < 5:
				return alt1
			if alt2 >= 0 and roll < 10:
				return alt2
		return _role("wall_c")
	var matched := int(_role_sides.get(key, -1))
	if matched >= 0:
		return matched
	# Fallback for a profile without the measured contract (the 12 sheets
	# whose art does not expose a clean dark face). The role table is the same
	# across the 16 sheets, so the real extras are still used by name.
	if n and s and w and e:
		return _role("wall_island")
	if n and w and e:
		return _role("wall_tip_n")
	if s and w and e:
		return _role("wall_tip_s")
	if n and s and w:
		return _role("wall_tip_w")
	if n and s and e:
		return _role("wall_tip_e")
	if n and s:
		return _role("wall_strip_h")
	if w and e:
		return _role("wall_strip_v")
	if n and w:
		return _role("wall_tl")
	if n and e:
		return _role("wall_tr")
	if s and w:
		return _role("wall_bl")
	if s and e:
		return _role("wall_br")
	if n:
		return _role("wall_t")
	if w:
		return _role("wall_l")
	if e:
		return _role("wall_r")
	if s:
		return _role("wall_b")
	return _role("wall_c")


func _diagonal_floor(x: int, y: int) -> bool:
	return _is_floor(x - 1, y - 1) and _is_floor(x + 1, y - 1) \
		and _is_floor(x - 1, y + 1) and _is_floor(x + 1, y + 1)


## Deep interior of the wall mass: all 8 neighbours are walls. The Wall Alt
## variation only applies here, never on an edge or corner (D-355).
func _deep_wall(x: int, y: int) -> bool:
	if not _is_solid(x, y):
		return false
	for dy in [-1, 0, 1]:
		for dx in [-1, 0, 1]:
			if dx == 0 and dy == 0:
				continue
			var nx: int = x + dx
			var ny: int = y + dy
			if not _is_solid(nx, ny):
				return false
	return true


func _ground_tile_index(x: int, y: int) -> int:
	var n := _is_solid(x, y - 1)
	var s := _is_solid(x, y + 1)
	var w := _is_solid(x - 1, y)
	var e := _is_solid(x + 1, y)
	if n and w:
		return _role("ground_tl")
	if n and e:
		return _role("ground_tr")
	if s and w:
		return _role("ground_bl")
	if s and e:
		return _role("ground_br")
	if n:
		return _role("ground_t")
	if w:
		return _role("ground_l")
	if e:
		return _role("ground_r")
	if s:
		return _role("ground_b")
	return _ground_center(x, y)


## Organic floor (D-347/D-356): only interior cells vary; the decal map is
## built once per floor with exactly 4% + 4% targets, a seeded shuffle and a
## 1-tile exclusion, so two decals never touch and the density is stable.
func _build_decals() -> void:
	_decals.clear()
	var alt1 := _role("ground_alt_1")
	var alt2 := _role("ground_alt_2")
	if alt1 < 0 and alt2 < 0:
		return
	var candidates: Array[Vector2i] = []
	for y in _map.size():
		for x in _map[y].length():
			if _is_interior_floor(x, y):
				candidates.append(Vector2i(x, y))
	if candidates.is_empty():
		return
	var rng := RandomNumberGenerator.new()
	rng.seed = _variation_seed
	for i in range(candidates.size() - 1, 0, -1):
		var j := rng.randi_range(0, i)
		var swap := candidates[i]
		candidates[i] = candidates[j]
		candidates[j] = swap
	var target1 := int(round(candidates.size() * 0.04))
	var target2 := int(round(candidates.size() * 0.04))
	var placed1 := 0
	var placed2 := 0
	for cell in candidates:
		if placed1 >= target1 and placed2 >= target2:
			break
		if _has_decal_near(cell):
			continue
		var role := -1
		if alt1 >= 0 and placed1 < target1 and (alt2 < 0 or placed1 <= placed2):
			role = alt1
			placed1 += 1
		elif alt2 >= 0 and placed2 < target2:
			role = alt2
			placed2 += 1
		if role >= 0:
			_decals[cell] = role


func _ground_center(x: int, y: int) -> int:
	var decal := int(_decals.get(Vector2i(x, y), -1))
	return decal if decal >= 0 else _role("ground_c")


func _has_decal_near(cell: Vector2i) -> bool:
	for dy in [-1, 0, 1]:
		for dx in [-1, 0, 1]:
			if dx == 0 and dy == 0:
				continue
			if _decals.has(cell + Vector2i(dx, dy)):
				return true
	return false


func _is_interior_floor(x: int, y: int) -> bool:
	if _is_wall(x, y):
		return false
	return not _is_wall(x - 1, y) and not _is_wall(x + 1, y) \
		and not _is_wall(x, y - 1) and not _is_wall(x, y + 1)


# --- Lights ------------------------------------------------------------------

## The player appears after this node's _ready, so its light is attached lazily.
## Enemies own their own lights (scripts/dungeon/enemy.gd).
func _attach_dynamic_lights() -> void:
	var player: Node2D = _parent.get("player")
	if player == null:
		return
	if _dust == null:
		_dust = _make_dust()
		add_child(_dust)
	# A poeira segue o jogador, mas as partículas já emitidas ficam no mundo.
	_dust.position = player.position
	if not _camera_fitted:
		_fit_camera(player)
		_camera_fitted = true


## Poeira ambiente cobrindo a área visível ao redor do jogador (D-313).
func _make_dust() -> CPUParticles2D:
	var dust := CPUParticles2D.new()
	dust.name = "Dust"
	dust.texture = _make_particle_texture()
	dust.amount = 30
	dust.lifetime = 7.0
	dust.preprocess = 7.0
	dust.local_coords = false
	dust.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
	dust.emission_shape = CPUParticles2D.EMISSION_SHAPE_RECTANGLE
	dust.emission_rect_extents = Vector2(520, 320)
	dust.direction = Vector2(0.15, -1)
	dust.spread = 180.0
	dust.initial_velocity_min = 2.0
	dust.initial_velocity_max = 7.0
	dust.gravity = Vector2.ZERO
	dust.scale_amount_min = 0.35
	dust.scale_amount_max = 0.9
	dust.color = Color(0.82, 0.9, 1.0, 0.16)
	return dust


func _make_particle_texture() -> GradientTexture2D:
	var g := Gradient.new()
	g.set_color(0, Color.WHITE)
	g.set_color(1, Color(1, 1, 1, 0))
	var tex := GradientTexture2D.new()
	tex.gradient = g
	tex.fill = GradientTexture2D.FILL_RADIAL
	tex.fill_from = Vector2(0.5, 0.5)
	tex.fill_to = Vector2(1.0, 0.5)
	tex.width = 16
	tex.height = 16
	return tex


## Keeps the camera inside the map, but only on axes where the map is actually
## bigger than the screen. Limits smaller than the viewport make Godot clamp the
## camera to an invalid rectangle, which is what froze the vertical scroll.
## On the axes that fit, both limits collapse to the map centre.
func _fit_camera(player: Node2D) -> void:
	var cam: Camera2D = null
	for child in player.get_children():
		if child is Camera2D:
			cam = child
			break
	if cam == null:
		return
	var map_size := Vector2(_map[0].length(), _map.size()) * TILE
	var view := get_viewport_rect().size / cam.zoom
	if map_size.x > view.x:
		cam.limit_left = 0
		cam.limit_right = int(map_size.x)
	else:
		cam.limit_left = int(map_size.x * 0.5)
		cam.limit_right = int(map_size.x * 0.5)
	if map_size.y > view.y:
		cam.limit_top = 0
		cam.limit_bottom = int(map_size.y)
	else:
		cam.limit_top = int(map_size.y * 0.5)
		cam.limit_bottom = int(map_size.y * 0.5)
	cam.reset_smoothing()


# --- Drawing -----------------------------------------------------------------

func _is_wall(x: int, y: int) -> bool:
	if y < 0 or y >= _map.size() or x < 0 or x >= _map[y].length():
		return true
	return _map[y][x] == "#"


## Wall that really exists inside the map. Outside is empty/open for the
## tile mask (D-348); _is_wall above is still used for lights/torches.
func _is_solid(x: int, y: int) -> bool:
	if y < 0 or y >= _map.size() or x < 0 or x >= _map[y].length():
		return false
	return _map[y][x] == "#"


func _is_floor(x: int, y: int) -> bool:
	if y < 0 or y >= _map.size() or x < 0 or x >= _map[y].length():
		return false
	return _map[y][x] != "#"


func _hash(x: int, y: int) -> int:
	return absi((x * 73856093) ^ (y * 19349663))


func _draw() -> void:
	var player: Node2D = _parent.get("player")
	# D-1016: the blob shadow is hidden under characters that use a 3D model.
	if player != null and not player.has_meta("model_3d"):
		_blob(player.position + Vector2(0, 14), 13.0, 5.0)
	var npcs: Array = _parent.get("npcs") if _parent.get("npcs") != null else []
	for npc in npcs:
		_blob(npc.position + Vector2(0, 14), 13.0, 5.0)


func _blob(pos: Vector2, rx: float, ry: float) -> void:
	_ellipse(pos, rx, ry, Color(0, 0, 0, 0.4))


func _ellipse(pos: Vector2, rx: float, ry: float, color: Color) -> void:
	draw_set_transform(pos, 0.0, Vector2(rx, ry))
	draw_circle(Vector2.ZERO, 1.0, color)
	draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
