static func get_random_candidate() -> Dictionary:
	return CANDIDATES[randi() % CANDIDATES.size()]


static func get_random_dialogue() -> String:
	return DIALOGUES[randi() % DIALOGUES.size()]


static func get_sprite_path(id: String, frame: int = 1) -> String:
	var frame_part := "frame2/" if frame == 2 else ""
	return "res://personagens/overworld/down/%s%s.png" % [frame_part, id]


## Retorna o caminho do retrato estilo Pokémon Mystery Dungeon (SpriteCollab)
static func get_pmd_portrait_path(id: String) -> String:
	var path := "res://personagens/portraits/%s.png" % id
	if ResourceLoader.exists(path):
		return path
	return "res://personagens/icons/%s.png" % id
